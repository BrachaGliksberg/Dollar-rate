    "ts-node-dev": "^2.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "supertest": "^6.3.3",
    "eslint": "^9.0.0",
    "@types/node": "^20.10.0",
    "@types/pg": "^8.10.2",
    "@types/express": "^5.0.6",
    "@types/cors": "^2.8.19",
    "@types/jest": "^29.5.0",
    "@types/supertest": "^2.0.12",
    "@types/node-cron": "3.0.11",
    "@typescript-eslint/eslint-plugin": "^8.50.0",
